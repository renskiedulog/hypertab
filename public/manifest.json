{
  "manifest_version": 3,
  "name": "HyperTab",
  "version": "1.0",
  "description": "A Chrome extension built with Vite + React",

  "action": {
    "default_popup": "index.html"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "permissions": [
    "topSites",
    "notifications"
  ],

  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "host_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-analyzer.js"]
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["facebook-notif.js"]
    },
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["gmail-notif.js"]
    },
    {
      "matches": ["*://cliq.zoho.com/*", "*://cliq.zoho.eu/*", "*://cliq.zoho.in/*"],
      "js": ["cliq-notif.js"]
    }
  ]
}
